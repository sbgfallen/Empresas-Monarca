# ============================
# Servidor - Variables de Entorno
# Copia este archivo como .env y ajusta los valores
# ============================

# ─── Puerto del servidor ───────────────────────────
PORT=5000

# ─── Base de datos PostgreSQL ──────────────────────
# Neon (producción/desarrollo) — usa DATABASE_URL
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# O conexión local (solo si no hay DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=premium_marketplace
DB_USER=postgres
DB_PASSWORD=020222Mm.

# ─── Autenticación JWT ──────────────────────────────
# Cambia esto por un secreto seguro en producción
JWT_SECRET=change-me-to-a-secure-random-string
ADMIN_JWT_SECRET=

# Duración de la sesión admin en horas (default: 8)
ADMIN_SESSION_HOURS=8

# ─── Admin por defecto (se crea al iniciar si no existe) ──
ADMIN_EMAIL=admin@sabri.com
ADMIN_PASSWORD=Sabri2024!
ADMIN_NAME=Admin
ADMIN_ROLE=admin

# ─── CORS - Orígenes permitidos (separados por coma) ────
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ─── Entorno ────────────────────────────────────────
# "development" | "production"
NODE_ENV=development
